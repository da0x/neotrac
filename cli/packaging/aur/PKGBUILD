pkgname=neotrac
pkgver=0.4.0
pkgrel=1
pkgdesc="The issues waiting for you, or for a service, on neotrac, on the command line"
arch=('x86_64' 'aarch64')
url="https://github.com/da0x/neotrac"
license=('GPL-3.0-only')
depends=('botan' 'gcc-libs')
makedepends=('libember')
source=("$pkgname-$pkgver.tar.gz::https://github.com/da0x/neotrac/archive/refs/tags/cli-v$pkgver.tar.gz")
sha256sums=('80077e4e69c7857d007d65cfdc53495a3599e08a3c3cfe028cd56a3f7e27afd8')

build() {
	cd "neotrac-cli-v$pkgver/cli"
	make CXXFLAGS="$CXXFLAGS"
}

package() {
	cd "neotrac-cli-v$pkgver/cli"
	make DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
