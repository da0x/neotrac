// Issues, numbered within their project: issue 12 of uione is uione-12. Every
// change to one is kept, and shown as its history.
//
// An issue is in one of its project's stages, and moves along the steps between
// them. Each step names the roles that may take it, so who moves what where is
// the project's to say, in its settings (workflow.one).

namespace projects {

	// How soon an issue matters, the most urgent first. An issue's color says it, as
	// Trac's did: red for critical, yellow for high, plain for normal, then cyan and
	// blue for what can wait.
	enum priority {
		critical  "Critical"
		high      "High"
		normal    "Normal"
		low       "Low"
		trivial   "Trivial"
	}

	entity issue history {
		project   project   required  key
		number    serial    per project  key  "#"
		board     board     required
		title     text      required
		body      markdown  "Description"
		labels    list of text
		author    user      = me
		stage     stage
		priority  priority  required = priority::normal
		// Who's working on it, from the project's people.
		assignees  list of user  "Assigned to"
		// The milestone it's part of, if any (milestones.one).
		milestone  milestone
		// Files that go with it, like a screenshot, a log, or what an agent made.
		attachments  list of file
		// Where it is in its board's order, which people drag it into. A new issue
		// starts at its number, so it comes last, and #1 comes before #2.
		position  number
		// Why it's closed, from whatever stage it was in; none while it's open.
		closed  resolution  "Closed"
		duplicate_of  issue  "Duplicate of"
		// What it depends on: it isn't taken or moved until each has reached a stage
		// whose status is success, and shows as waiting till then. Its blocked by links
		// keep it.
		waits_on  list of issue  "Waits on"
		// On a board shown as a canvas: how it's drawn, a note or large text, and where
		// it's placed and how big.
		kind  enum  note | text = kind::note
		x  number
		y  number
		w  number
		h  number
	}

	// Why an issue was closed: finished, not to be done, or already asked for.
	enum resolution {
		done       "Done"
		wont_do    "Won't do"
		duplicate  "Duplicate"
	}

	// How one issue bears on another, said from each side: one blocks another, which
	// is blocked by it.
	enum relation {
		// Said as what waits on what, which holds until the other has succeeded.
		blocks         "Needed by"
		blocked_by     "Depends on"
		relates        "Relates to"
		duplicates     "Duplicates"
		duplicated_by  "Duplicated by"
		replaces       "Replaces"
		replaced_by    "Replaced by"
	}

	// One issue bearing on another of its project's, on any of its boards: it blocks
	// it, or repeats it, or replaces it, as a decision supersedes an older one. A link
	// is kept from each side, so each issue's page says it in its own words.
	entity link {
		project   project   = from.project
		from      issue     required
		to        issue     required
		relation  relation  = relation::relates
		// On the side kept for the other issue, the link it was made with.
		pair      link
	}

	// A comment is kept in its issue's history too, so it's in the What's new of
	// whoever follows the issue's board or is assigned it, and of whoever it names
	// with @username.
	entity comment history of issue {
		issue      issue     required
		body       markdown  required
		author     user      = me
		mentioned  list of user = mentions(body)
	}

	// A new issue starts in the stage its board starts issues in.
	command issue::create {
		stage = board.start
		position = number
	}

	command issue::update

	// Attaching files, and taking them away, without changing anything else: how an
	// agent hands back what it made.
	command issue::attach {
		changes attachments
	}

	// To another of its project's boards, where it starts in the stage that board
	// starts issues in. Its number, and so its address, stay the same.
	command issue::transfer {
		changes board
		require board.project == project  "pick one of this project's boards"
		stage = board.start
	}

	// Closed from whatever stage it's in, saying why. It leaves its board's columns
	// and keeps its stage, so reopening puts it back where it was. A duplicate says
	// which issue it repeats, linked from both.
	command issue::close {
		changes closed  duplicate_of
		require closed != none  "say why it's closed"
		require closed != resolution::duplicate || duplicate_of != none  "pick the issue it duplicates"
		if closed == resolution::duplicate {
			dispatch link::create {
				from = id  to = duplicate_of  relation = relation::duplicates
			}
		}
	}

	command issue::reopen {
		require closed != none  "it's open"
		closed = none
		duplicate_of = none
	}

	command link::create {
		require to != from  "pick another issue"
		require from.project == project && to.project == project  "pick one of this project's issues"
		// A public issue never names one on a private board.
		require from.board.visibility == to.board.visibility  "link it to an issue on a board that's private or public as its own is"
		// The other side, said from there. The link made for it has a pair, so it
		// makes no other.
		// Blocked by another, it waits on it.
		if relation == relation::blocked_by {
			each issue where id == from {
				dispatch issue::update { add link.to to waits_on }
			}
		}
		if pair == none {
			dispatch link::create {
				pair = id  from = to  to = from
				relation = match relation {
					blocks         blocked_by
					blocked_by     blocks
					relates        relates
					duplicates     duplicated_by
					duplicated_by  duplicates
					replaces       replaced_by
					replaced_by    replaces
				}
			}
		}
	}

	// Both sides go together.
	command link::delete {
		if relation == relation::blocked_by {
			each issue where id == from {
				dispatch issue::update { remove link.to from waits_on }
			}
		}
		each other link where other.pair == id || other.id == pair {
			dispatch link::delete
		}
	}

	// How an issue moves: along a step from the stage it's in that one of the
	// person's roles may take (workflow.one). Whoever works a stage takes an issue in
	// it for half an hour at a time, renewing while they work, so two never work it at
	// once, and one who stops working it lets it go by itself.
	define workflow issue by stage {
		worked by worked_by
		steps step
		// It waits on what it depends on, until each is at a stage that's a success.
		depends on waits_on
		done when stage.status == status::success
		// A closed issue keeps its stage, to reopen where it was, but no one works it.
		while closed == none
		lease 30 minutes
	}

	// An issue placed somewhere else on its board's canvas, or made bigger.
	command issue::place {
		changes x  y  w  h
	}

	command comment::create

	// An issue's log: what whoever works it writes as they go, a few lines at a time,
	// read as it grows, like a program's output while an agent runs it.
	entity entry {
		issue   issue  required
		text    text   required
		author  user   = me
	}
	command entry::create
	command entry::delete

	// An issue goes with its comments and links, when its board or project does.
	command issue::delete {
		each comment where issue == id {
			dispatch comment::delete
		}
		each entry where issue == id {
			dispatch entry::delete
		}
		each link where from == id || to == id {
			dispatch link::delete
		}
	}

	command comment::delete

	view issue_page per issue {
		number  title  body  labels  stage  stage.title  priority  assignees
		assignees.name  held_by  held_by.name  held_until  data  milestone
		milestone.title  attachments  board  board.title  closed  duplicate_of  duplicate_of.number
		// How it bears on others, and they on it, each said from this side.
		links = each link where from == issue.id {
			relation  to  to.number  to.title
		}
		steps = each step where board == issue.board {
			from  to  from.title  to.title  title  roles
		}
		comments = each comment in issue {
			order by created_at
			author.picture  author.name  body  created_at
		}
		logged = count(log)
		// The newest of its log, newest first.
		log = each entry in issue {
			order by created_at descending
			limit 200
			text  author.name  created_at
		}
		history = each change in issue {
			order by created_at
			field  before  after  action  created_by.name  created_at
		}
	}

	screen "#{issue_page.number} {issue_page.title}" /:project/:issue {
		under /:project/boards/:board "{issue_page.board.title}"
		layout two_columns
		main {
			markdown "{issue_page.body}"
			table issue_page.links link /:project/:to {
				hide when empty
				relation "Linked"
				to.number "#"
				to.title "Issue"
				delete "Remove"
			}
			section "Log" when issue_page.logged > 0 {
				table issue_page.log {
					hide when empty
					page 20
					created_at "When"
					author.name "By"
					text "Said"
				}
			}
			timeline issue_page.history
			thread issue_page.comments
			form comment::create "Comment" {
				body "Comment"
			}
		}
		side {
			issue::move along issue_page.steps
			issue::claim "Take it" when issue_page.held_by != me && issue_page.closed == none
			issue::release "Let it go" when issue_page.held_by == me
			issue::close "Close" when issue_page.closed == none form "Close" {
				closed "Why"  duplicate_of "Duplicate of"
			}
			issue::reopen "Reopen" when issue_page.closed != none
			details issue_page {
				tint by priority
				closed "Closed"
				duplicate_of.number "Duplicate of"
				stage.title "Stage"
				assignees.name
				held_by.name "Held by"
				held_until "Until"
				data "Status"
				milestone.title "Milestone"
				priority "Priority"
				labels "Labels"
				attachments "Attachments"
			}
			issue::update "Edit" form "Save" {
				title  body  assignees  milestone  priority  labels  attachments
			}
			link::create "Link an issue" form "Link" {
				relation "This issue"  to "Issue"
			}
			issue::transfer "Transfer to another board" form "Transfer" {
				board "Board"
			}
			copy issue_page "Copy issue"
		}
	}

} // namespace projects
