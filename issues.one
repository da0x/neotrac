// Issues, numbered within their project: issue 12 of uione is uione-12. Every
// change to one is kept, and shown as its history.
//
// An issue is in one of its project's phases, and moves along the steps between
// them. Each step names the roles that may take it, so who moves what where is
// the project's to say, in its settings (workflow.one).

namespace projects {

	// How soon an issue matters, the most urgent first. An issue's color says it, as
	// Trac's did: red for critical, yellow for high, plain for normal, then cyan and
	// blue for what can wait.
	enum priority {
		critical  "Critical"
		high      "High"
		normal    "Normal"
		low       "Low"
		trivial   "Trivial"
	}

	entity issue history {
		project   project   required  key
		number    serial    per project  key
		board     board     required
		title     text      required
		body      markdown
		labels    list of text
		author    user      = me
		phase     phase
		priority  priority  required = priority::normal
		// Who's working on it, from the project's people.
		assignees  list of user
		// The milestone it's part of, if any (milestones.one).
		milestone  milestone
	}

	// How one issue bears on another, said from each side: one blocks another, which
	// is blocked by it.
	enum relation {
		blocks         "Blocks"
		blocked_by     "Blocked by"
		relates        "Relates to"
		duplicates     "Duplicates"
		duplicated_by  "Duplicated by"
		replaces       "Replaces"
		replaced_by    "Replaced by"
	}

	// One issue bearing on another of its project's, on any of its boards: it blocks
	// it, or repeats it, or replaces it, as a decision supersedes an older one. A link
	// is kept from each side, so each issue's page says it in its own words.
	entity link {
		project   project   required
		from      issue     required
		to        issue     required
		relation  relation  = relation::relates
		// On the side kept for the other issue, the link it was made with.
		pair      link
	}

	// A comment is kept in its issue's history too, so it's in the What's new of
	// whoever follows the issue's board or is assigned it, and of whoever it names
	// with @username.
	entity comment history of issue {
		issue      issue     required
		body       markdown  required
		author     user      = me
		mentioned  list of user = mentions(body)
	}

	// A new issue starts in the phase its board starts issues in.
	command issue::create {
		phase = board.start
	}

	command issue::update

	// To another of its project's boards, where it starts in the phase that board
	// starts issues in. Its number, and so its address, stay the same.
	command issue::transfer {
		changes board
		require board.project == project  "pick one of this project's boards"
		phase = board.start
	}

	command link::create {
		require to != from  "pick another issue"
		require from.project == project && to.project == project  "pick one of this project's issues"
		// The other side, said from there. The link made for it has a pair, so it
		// makes no other.
		if pair == none {
			dispatch link::create {
				project = project  pair = id  from = to  to = from
				relation = match relation {
					blocks         blocked_by
					blocked_by     blocks
					relates        relates
					duplicates     duplicated_by
					duplicated_by  duplicates
					replaces       replaced_by
					replaced_by    replaces
				}
			}
		}
	}

	// Both sides go together.
	command link::delete {
		each other link where other.pair == id || other.id == pair {
			dispatch link::delete
		}
	}

	// Along a step from the phase it's in, that one of the person's roles may take.
	command issue::move {
		changes phase
		require "your role doesn't move an issue from there to there" {
			exists(step where from == was issue.phase && to == issue.phase && held(roles))
		}
	}

	command comment::create

	view issue_page per issue {
		readers member
		public when issue.project.visibility == visibility::public
		number = issue.number
		title = issue.title
		body = issue.body
		labels = issue.labels
		phase = issue.phase
		phase_title = issue.phase.title
		priority = issue.priority
		assignees = issue.assignees
		assigned = issue.assignees.name
		milestone = issue.milestone
		milestone_title = issue.milestone.title
		board = issue.board
		board_title = issue.board.title
		// How it bears on others, and they on it, each said from this side.
		links = each link where from == issue.id {
			relation  to  to.number  to.title
		}
		steps = each step where board == issue.board {
			from  to  from.title  to.title  title  roles
		}
		comments = each comment in issue {
			order by created_at
			author.picture  author.name  body  created_at
		}
		history = each change in issue {
			order by created_at
			field  before  after  action  created_by.name  created_at
		}
	}

	screen "#{issue_page.number} {issue_page.title}" /:project/:issue under /:project/boards/:board "{issue_page.board_title}" layout two_columns {
		main {
			markdown "{issue_page.body}"
			table issue_page.links link /:project/:to {
				hide when empty
				relation "Linked"
				to.number "#"
				to.title "Issue"
				delete "Remove"
			}
			timeline issue_page.history
			thread issue_page.comments
			form comment::create "Comment" {
				body "Comment"
			}
		}
		side {
			issue::move along issue_page.steps
			details issue_page {
				tint by priority
				phase_title "Phase"
				assigned "Assigned to"
				milestone_title "Milestone"
				priority "Priority"
				labels "Labels"
			}
			issue::update "Edit" form "Save" {
				title  body "Description"  assignees "Assigned to"  milestone  priority  labels
			}
			link::create "Link an issue" form "Link" {
				relation "This issue"  to "Issue"
			}
			issue::transfer "Transfer to another board" form "Transfer" {
				board "Board"
			}
			copy issue_page "Copy issue"
		}
	}

} // namespace projects
