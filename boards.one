// A project's boards: each its own issues, moving through its own workflow, like a
// product's work, its marketing and its executive matters side by side. The people
// and their roles are the project's, the same on every board.

namespace projects {

	// A board of a project, named from its title when it's made.
	entity board {
		// Read by its project's people; by everyone too while both it and its project
		// are public.
		readers member
		public when {
			visibility == visibility::public
			project.visibility == visibility::public
		}
		project   project  required  key
		name      text     required  key = slug(title)
		title     text     required
		// The preset it started from, and the stage new issues start in.
		workflow  workflow = workflow::basic
		start     stage
		position  number
		// A private board is read by the project's people alone, even in a public project.
		visibility  enum  public | private = visibility::public
		// How its issues are shown: a list, as tickets are; a board, in columns by stage; a
		// pipeline, a lane for each kind, as a release's are; or a whiteboard, placed
		// anywhere in columns by stage, as ideas are. Switching keeps each where it was.
		style  enum  list | board | pipeline | whiteboard = style::board
		// Who follows it, to find it on their front page.
		followers  list of user
	}

	// A private project's boards are private: only a public project has public boards,
	// beside private ones its people keep to themselves.
	command board::update {
		require visibility == visibility::private || project.visibility == visibility::public  "a private project's boards are private; make the project public first"
	}

	// A board goes with its issues, and its stages and steps, once its title is typed
	// to say so.
	command board::delete {
		input typed text
		require typed == title  "type the board's title to delete it"
		each issue where board == id {
			dispatch issue::delete
		}
		each step where board == id {
			dispatch step::delete
		}
		each stage where board == id {
			dispatch stage::delete
		}
	}

	// Anyone signed in follows a board, and stops.
	command board::follow {
		by anyone signed in
		add me to followers
	}

	command board::unfollow {
		by anyone signed in
		remove me from followers
	}

	view board_page per board {
		title  start  visibility  style  followers  project.name
		issues = each issue in board where closed == none {
			order by position
			number  title  labels  stage  stage.title  priority  updated_at  position
			author  author.picture  author.name  assignees  assignees.name  assignees.picture
			milestone  data  held_by  held_by.name  held_until  kind  x  y  w  h  waits_on  attachments
		}
		// What was closed, the last closed first, and why.
		closed = each issue in board where closed != none {
			order by updated_at descending
			number  title  labels  closed  stage.title  priority  updated_at
		}
		// The project's milestones, soonest first, then oldest first, as a track above its issues.
		milestones = each milestone where project == board.project && archived != true {
			order by due  created_at
			name  title  due  created_at
		}
		stages = each stage in board {
			order by position
			name  title  position  worked_by  worked_by.title  status  notify  kinds  width
		}
		steps = each step in board {
			order by from.position  to.position
			from  to  from.title  from.position  to.title  to.position  title  roles  roles.title
		}
	}

	screen "{board_page.title}" /:project/boards/:board {
		heading {
			board::follow "Follow" icon follow when !(board_page.followers has me)
			board::unfollow "Stop following" icon following when board_page.followers has me
			link /:project/boards/:board/closed "Closed" icon archive
			link /:project/boards/:board/workflow "Workflow" icon workflow
			board::update "Edit board" icon edit form "Save" {
				title
				visibility "Who sees it" {
					hint "A private board, its issues and their history are seen by the project's people alone."
						"In a private project, every board is private."
				}
				style "Show issues as" {
					hint "List: tickets one under another. Board: in columns by stage. Pipeline: a lane for each kind of issue, by its labels, along the stages it goes through."
				}
			}
			board::delete "Delete board" icon delete form "Delete it for good" {
				typed "Its issues are deleted with it. Type its title to confirm"
			}
		}
		table board_page.issues by stage over board_page.stages link /:project/:issue when board_page.style == style::list {
			// The milestones as a timeline above the issues, however they're shown:
			// picking one shows only its issues. The last, where the work is, is
			// picked until another is.
			track milestone over board_page.milestones {
				hide when empty
				picked last
				due "Due"
			}
			search title labels stage.title priority
			issue::create "New issue" icon add
			reorder position
			page 25
			tint by priority
			number
			title
			labels
			assignees
			author "Opened by"
		}
		// A board kept as a whiteboard opens as a board: the whiteboard is put away for now.
		board board_page.issues by stage over board_page.stages link /:project/:issue when board_page.style == style::board || board_page.style == style::whiteboard {
			search title labels stage.title priority
			issue::create "New issue" icon add
			move issue::move along board_page.steps
			chime when notify has chime
			status by status
			reorder position
			tint by priority
			title
			number  labels  assignees
		}
		// A lane for each kind of issue, as its labels say, each a row of the stages its
		// kind goes through, the one it's at marked: a release's packages, sites and apps.
		pipeline board_page.issues by stage over board_page.stages link /:project/:issue when board_page.style == style::pipeline {
			lanes by labels
			path by kinds
			status by status
			title
			number
		}
		form issue::create "Open issue" {
			title  body  assignees  milestone  priority  labels  attachments
		}
		link /:project "All boards"
	}

	screen "{board_page.title}: closed" /:project/boards/:board/closed {
		under /:project/boards/:board "{board_page.title}"
		table board_page.closed link /:project/:issue {
			search title labels
			page 25
			tint by priority
			number
			title
			closed "Why"
			stage.title "Closed in"
			updated_at "When"
		}
	}

} // namespace projects
