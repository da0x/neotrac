// A project's boards: each its own issues, moving through its own workflow, like a
// product's work, its marketing and its executive matters side by side. The people
// and their roles are the project's, the same on every board.

namespace projects {

	// A board of a project, named from its title when it's made.
	entity board {
		project   project  required  key
		name      text     required  key = slug(title)
		title     text     required
		// The preset it started from, and the phase new issues start in.
		workflow  workflow = workflow::basic
		start     phase
		position  number
		// Who follows it, to find it on their front page.
		followers  list of user
	}

	command board::update

	// Anyone signed in follows a board, and stops.
	command board::follow {
		by anyone signed in
		add me to followers
	}

	command board::unfollow {
		by anyone signed in
		remove me from followers
	}

	view board_page per board {
		readers member
		public when board.project.visibility == visibility::public
		title = board.title
		start = board.start
		followers = board.followers
		project_name = board.project.name
		issues = each issue in board {
			order by number descending
			number  title  labels  phase  phase.title  priority  updated_at
			author  author.picture  author.name  assignees  assignees.name
		}
		phases = each phase in board {
			order by position
			name  title  position
		}
		steps = each step in board {
			order by from.position  to.position
			from  to  from.title  from.position  to.title  to.position  title  roles  roles.title
		}
	}

	screen "{board_page.title}" /:project/boards/:board {
		heading {
			board::follow "Follow" icon follow when !(board_page.followers has me)
			board::unfollow "Stop following" icon following when board_page.followers has me
			issue::create "New issue" icon add
			form issue::create "Open issue" {
				title  body "Description"  assignees "Assigned to"  milestone  priority  labels
			}
			link /:project/boards/:board/workflow "Workflow" icon workflow
			board::update "Edit board" icon edit
			form board::update "Save" {
				title
			}
		}
		table board_page.issues by phase over board_page.phases link /:project/:issue {
			search title labels phase.title priority
			sort by number descending
			page 25
			tint by priority
			number "#"
			title
			labels
			assignees.name "Assigned to"
			author.picture ""
			author.name "Opened by"
		}
		board board_page.issues by phase over board_page.phases link /:project/:issue {
			move issue::move along board_page.steps
			tint by priority
			title
			number "#"  labels  assignees.name
		}
		link /:project "All boards"
	}

} // namespace projects
