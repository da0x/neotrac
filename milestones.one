// A project's milestones, and its roadmap: what each release, or any goal, needs
// done and by when, and how far along it is, across the project's boards.

namespace projects {

	entity milestone {
		project      project   required  key
		name         text      required  key = slug(title)
		title        text      required
		due          date
		description  markdown
		// A finished milestone is archived: it leaves the boards' tracks and the
		// roadmap's cards, so they show today's work, and stays readable under Archived.
		archived     boolean
	}

	command milestone::create
	command milestone::update
	command milestone::archive {
		archived = true
	}
	command milestone::restore {
		archived = false
	}
	// A milestone goes, once its title is typed to say so, and its issues stay, part
	// of none.
	command milestone::delete {
		input typed text
		require typed == title  "type the milestone's title to delete it"
		each issue where milestone == id {
			dispatch issue::update { milestone = none }
		}
	}

	view milestone_page per milestone {
		title  due  description  archived
		// How far along it is: its issues at a stage that's a success, of them all.
		total = count(issues)
		done = count(issue where milestone == milestone.id && stage.status == status::success && board.visibility == visibility::public)
		issues = each issue in milestone where board.visibility == visibility::public {
			order by number descending
			number  title  board  board.title  stage.title  closed  priority  assignees.name  assignees.picture
		}
	}

	// Each milestone as a card, soonest first: when it's due, and its issues by stage.
	screen "Roadmap" /:project/roadmap {
		heading {
			milestone::create "New milestone" form "Add" {
				title  due "Due"  description
			}
		}
		cards project_page.milestones link /:project/milestones/:milestone {
			title
			due "Due"
			tally project_page.issues by milestone and stage
		}
		section "Archived" {
			table project_page.archived_milestones link /:project/milestones/:milestone {
				hide when empty
				title
				due "Due"
			}
		}
	}

	screen "{milestone_page.title}" /:project/milestones/:milestone {
		under /:project/roadmap "Roadmap"
		heading {
			milestone::update "Edit milestone" icon edit form "Save" {
				title  due "Due"  description
			}
			milestone::archive "Archive" icon archive when milestone_page.archived != true
			milestone::restore "Bring back" when milestone_page.archived == true
			milestone::delete "Delete milestone" icon delete form "Delete it" {
				typed "Its issues stay, in no milestone. Type its title to confirm"
			}
		}
		subtitle "{milestone_page.description}"
		text "{milestone_page.done} of {milestone_page.total} done"
		table milestone_page.issues link /:project/:issue {
			search title board.title
			tint by priority
			number
			title
			board.title "Board"
			stage.title "Stage"
			closed "Closed"
			assignees
		}
	}

} // namespace projects
