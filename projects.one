// Projects and the people in them. Whoever makes a project maintains it, and
// maintainers bring in others. A public project can be read by anyone; a private
// one only by its people.

namespace projects {

	entity project {
		slug           text  required  unique  key
		name           text  required
		summary        markdown
		visibility     enum  public | private = visibility::public
		takes_reports  boolean = false
		// How many steps an issue takes before it's done (issues.one).
		lifecycle      enum  full "Implement, verify, approve" | reviewed "Implement, verify" | simple "Start, finish" = lifecycle::full
	}

	// A person's place in a project, and what they may do there: one record for each
	// role they hold, so someone can both implement and verify, though never the same
	// issue.
	entity member {
		project  project  required  key
		person   user     required  key
		role     enum     maintainer "Maintainer" | developer "Developer" | tester "Tester" | approver "Approver" | reporter "Reporter"  key
	}

	command project::create {
		permission authenticated
		create member {
			project = id  person = me  role = role::maintainer
		}
	}

	command project::update
	command member::create

	// Taking a role away from someone, though never from yourself, so a project
	// always keeps the maintainer who took the others'.
	command member::delete {
		require person != me  "you can't remove yourself from a project"
	}

	// Maintainers run the project and may take any step; the others take their own.
	// Whoever holds several roles still never signs off on their own work, which
	// issues.one's commands make sure of.
	role maintainer per project from member {
		project::update  member::create  member::delete
		issue::create  issue::update  issue::close  issue::reopen
		issue::start  issue::implement  issue::finish  issue::verify  issue::sign_off  issue::approve  issue::send_back
		comment::create
		report::resolve  reply::create
	}
	role developer per project from member  issue::create  issue::update  issue::start  issue::implement  issue::finish  comment::create
	role tester per project from member  issue::create  issue::verify  issue::sign_off  issue::send_back  comment::create
	role approver per project from member  issue::create  issue::approve  issue::send_back  comment::create
	role reporter per project from member  issue::create  comment::create

	// Every public project, newest first. A private project is listed nowhere.
	view all public {
		each project where visibility == visibility::public {
			order -created_at
			slug  name
		}
	}

	// The projects a person belongs to, public or private.
	view mine per user {
		each member where person == user.id {
			order project
			project  project.name  role
		}
	}

	view project_page per project {
		readers member
		public when project.visibility == visibility::public
		name = project.name
		summary = project.summary
		visibility = project.visibility
		takes_reports = project.takes_reports
		lifecycle = project.lifecycle
		issues = each issue where project == project.id {
			order -status  -number
			number  title  labels  status  implemented_by.name  author.picture  author.name
		}
		members = each member where project == project.id {
			order role
			person.picture  person.name  role
		}
		timeline = each change of issue where project == project.id {
			order -created_at
			limit 100
			issue  issue.number  issue.title  field  before  after  action  created_by.name  created_at
		}
	}

	screen "Projects" / {
		table all link /:project {
			slug "Project"
			name
		}
		table mine link /:project {
			project.name "Yours"
			role
		}
		table my_reports link /:project/reports/:report {
			project
			title "Your reports"
			status
		}
		project::create "New project"
		form project::create "Create project" {
			slug  name  summary  visibility  takes_reports
		}
	}

	screen "{project_page.name}" /:project {
		markdown "{project_page.summary}"
		issue::create "New issue"
		form issue::create "Open issue" {
			title  body "Description"  labels
		}
		project::update "Edit project"
		form project::update "Save" {
			name  summary  visibility  takes_reports  lifecycle
		}
		table project_page.issues by status link /:project/issues/:issue {
			search title labels
			sort -number
			page 25
			number "#"
			title
			labels
			status
			implemented_by.name "Implementing"
			author.picture ""
			author.name "Opened by"
		}
		link /:project/timeline "Timeline"
		link /:project/people "People"
		link /:project/report "Report a problem privately"
		link /:project/reports "Reports, for its people"
	}

	// Everything that happened to a project's issues, newest first.
	screen "{project_page.name}: timeline" /:project/timeline {
		timeline project_page.timeline link /:project/issues/:issue
	}

	screen "People" /:project/people {
		table project_page.members {
			person.picture ""
			person.name "Name"
			role
			delete "Remove"
		}
		confirm member::delete "Take this role away from them?"
		member::create "Add someone"
		form member::create "Add" {
			person  role
		}
	}

} // namespace projects
