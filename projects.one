// Projects and the people in them. Whoever makes a project maintains it, and
// maintainers bring in others. A public project can be read by anyone; a private
// one only by its people.

namespace projects at / {

	entity project {
		slug           text  required  unique  key
		name           text  required
		summary        markdown
		visibility     enum  public | private = visibility::public
		takes_reports  boolean = false
		// The preset its first board starts from (boards.one). start is where its
		// issues started before projects had boards, which its first board took.
		workflow       workflow = workflow::basic
		start          phase
	}

	// Each project has its own roles, which it changes, or adds to, in its settings,
	// with no deploy; these are the two it starts with. The language keeps them as
	// role records, and a person's place in a project as a member record for each
	// role they hold. Which steps between phases each role may take is the
	// project's to say.

	// Runs the project and its settings.
	define role maintainer "Maintainer" in project {
		project::update
		member::create
		member::delete
		invitation::create
		invitation::delete
		role::create
		role::update
		role::delete
		board::create
		board::update
		phase::create
		phase::update
		phase::delete
		step::create
		step::update
		step::delete
		milestone::create
		milestone::update
		page::create
		page::update
		issue::create
		issue::update
		issue::move
		issue::transfer
		link::create
		link::delete
		comment::create
		report::resolve
		reply::create
	}

	// Works on the project's issues, its milestones and its wiki.
	define role contributor "Contributor" in project {
		issue::create
		issue::update
		issue::move
		issue::transfer
		link::create
		link::delete
		comment::create
		milestone::create
		milestone::update
		page::create
		page::update
	}

	// Whoever makes a project maintains it, and it starts with a board called what the
	// project is, from the preset they pick.
	command project::create {
		by anyone signed in
		dispatch member::create {
			project = id  person = me  role = role::maintainer
		}
		dispatch board::create {
			project = id  name = "main"  title = name  workflow = workflow  position = 1
		}
	}

	command project::update
	command member::create

	// Taking a role away from someone, though never from yourself, so a project
	// always keeps the maintainer who took the others'.
	command member::delete {
		require person != me  "you can't remove yourself from a project"
	}

	command role::create
	command role::update

	// Removing a role no one holds; whoever holds it is given another first.
	command role::delete {
		require !exists(member where role == id)  "give its people another role first"
	}

	// Every public project, newest first. A private project is listed nowhere.
	view all public {
		each project where visibility == visibility::public {
			order by created_at descending
			slug  name
		}
	}

	// The issues a person is working on, in any project, newest first.
	view assigned per user {
		each issue where assignees has me {
			order by number descending
			project  number  title  project.name  phase.title
		}
	}

	// When a person last looked at what's new to them, so what came after is marked
	// new: one for each person, set each time they look.
	entity reader {
		person   user  key  = me
		seen_at  date
	}

	command reader::create {
		by anyone signed in
		require person == me  "you can only say when you looked yourself"
		seen_at = now
	}

	// What's new to a person: each change on the boards they follow, to the issues
	// assigned to them, and each comment naming them, newest first, leaving out
	// their own. Only what they may read
	// is in it, so a private project's changes go once they leave it.
	view news per user {
		changes = each change in issue where {
			board.followers has me || assignees has me || mentioned has me
			created_by != me
		} {
			order by created_at descending
			limit 30
			project  project.name  issue  issue.number  issue.title
			field  before  after  action  created_by.name  created_at
		}
		seen = first(reader where person == me).seen_at
		unread = count(changes where created_at > seen)
	}

	// The boards a person follows, in any project.
	view followed per user {
		each board where followers has me {
			order by title
			project  title  project.name
		}
	}

	// The projects a person belongs to, public or private.
	view mine per user {
		each member where person == me {
			order by project
			project  project.name  role.title
		}
	}

	view project_page per project {
		readers member
		public when project.visibility == visibility::public
		name = project.name
		summary = project.summary
		visibility = project.visibility
		takes_reports = project.takes_reports
		boards = each board in project {
			order by position
			name  title
		}
		issues = each issue in project {
			number  title  labels  board  milestone  phase  phase.title  phase.position
		}
		milestones = each milestone in project {
			order by due
			name  title  due
		}
		pages = each page in project {
			order by position
			name  title  position  updated_at
		}
		members = each member in project {
			order by role
			person  person.picture  person.name  role.title
		}
		roles = each role in project {
			order by name
			name  title  may
		}
		timeline = each change in issue in project {
			order by created_at descending
			limit 100
			issue  issue.number  issue.title
			field  before  after  action  created_by.name  created_at
		}
		// The latest few, for the project's own page.
		recent = each change in issue in project {
			order by created_at descending
			limit 5
			issue  issue.number  issue.title
			field  before  after  action  created_by.name  created_at
		}
	}

	// The front page: every public project, found by its name, and, for whoever is
	// signed in, their own projects and the boards they follow.
	screen "neotrac" / {
		hero "Open project tracking for everyone" {
			text "Projects, issues, and the history of every change, in the open."
			link /about "Why neotrac"
		}
		timeline news.changes "What's new" link /:project/:issue {
			new since news.seen
			seen reader::create
		}
		table mine link /:project {
			project.name "Your projects"
			role.title "Role"
		}
		table assigned link /:project/:issue {
			hide when empty
			number "#"
			title "Assigned to you"
			project.name "Project"
			phase.title "Phase"
		}
		table followed link /:project/boards/:board {
			hide when empty
			title "Boards you follow"
			project.name "Project"
		}
		table all link /:project {
			search name slug
			name "Projects"
			slug "Address"
			project::create "New project"
		}
		table my_reports link /:project/reports/:report {
			hide when empty
			project
			title "Your reports"
			status
		}
		form project::create "Create project" {
			slug  name  summary  visibility  takes_reports  workflow "Start from"
		}
	}

	screen "{project_page.name}" /:project layout two_columns {
		heading {
			board::create "New board" icon add form "Create board" {
				title  workflow "Start from"
			}
			project::update "Edit project" icon edit form "Save" {
				name  summary  visibility  takes_reports
			}
		}
		subtitle "{project_page.summary}"
		// Each board as a card: how its issues stand, phase by phase, and the two
		// ways it's most often looked at.
		main {
			// Every issue by its number, title or labels, and every wiki page by its title.
			find "Search this project" {
				project_page.issues "Issues" link /:project/:issue by number title labels
				project_page.pages "Wiki" link /:project/wiki/:page by title
			}
			cards project_page.boards link /:project/boards/:board {
				title
				tally project_page.issues by board and phase
				filter "Assigned to me" assignees == me  color blue
				filter "High priority" priority == priority::high  color red
				filter "Changed this week" updated_at > 7 days ago  color green
			}
			timeline project_page.recent "Recent activity" link /:project/:issue
			link /:project/timeline "All activity"
		}
		// What's in each part of the project, a glance at a time, and the way in.
		side {
			// What's due in the next two weeks, or overdue: the last 5% to finish.
			section "Due soon" {
				table project_page.milestones link /:project/milestones/:milestone {
					only due <= 2 weeks from now
					hide when empty
					title "Milestone"
					due "Due"
				}
				link /:project/roadmap "Open the roadmap"
			}
			section "Wiki" {
				table project_page.pages link /:project/wiki/:page {
					color violet
					title "Page"
				}
				link /:project/wiki "Open the wiki"
			}
			section "People" {
				link /:project/people "Who works on it"
				link /:project/report "Report a problem privately"
				link /:project/reports "Reports, for its people"
			}
		}
	}

	// Everything that happened to a project's issues, newest first.
	screen "{project_page.name}: timeline" /:project/timeline {
		timeline project_page.timeline link /:project/:issue
	}

	// Someone asked to join a project, by the email they sign in with. Once they sign
	// in with it, they're a member with its role, by who they are, not by their
	// email, so changing it later changes nothing, and the invitation is done. Only an
	// email they're known to have takes one: their Google sign-in's, or any address
	// GitHub has verified for their GitHub account.
	entity invitation invites member {
		project  project  required  key
		email    email    required  key
		role     role     required
	}

	command invitation::create
	command invitation::delete

	// Who's been asked to join, read only by the project's people, since it names
	// their email.
	view invitations per project {
		readers member
		invited = each invitation in project {
			order by created_at
			email  role.title
		}
	}

	screen "People" /:project/people {
		table project_page.members {
			person.picture ""
			person.name "Name"
			role.title "Role"
			delete "Remove" when person != me
		}
		confirm member::delete "Take this role away from them?"
		invitation::create "Add someone" form "Invite" {
			email "Email"  role
		}
		text "They join once they sign in with that email. Tell them, and send them here."
		table invitations.invited {
			hide when empty
			email "Invited"
			role.title "Role"
			delete "Withdraw"
		}
		link /:project/roles "Roles, and what each allows"
	}

	// A role's own page, where what it allows is changed.
	view role_page per role {
		readers member
		name = role.name
		title = role.title
		may = role.may
	}

	screen "Roles" /:project/roles {
		table project_page.roles link /:project/roles/:role {
			title "Role"
		}
		role::create "New role" form "Create role" {
			name  title  may "Allows"
		}
	}

	screen "{role_page.title}" /:project/roles/:role {
		role::update "Edit" form "Save" {
			title  may "Allows"
		}
	}

} // namespace projects
