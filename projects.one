// Projects and the people in them. Whoever makes a project maintains it, and
// maintainers bring in others. A public project can be read by anyone; a private
// one only by its people.

namespace projects {

	entity project {
		slug           text  required  unique  key
		name           text  required
		summary        markdown
		visibility     enum  public | private = visibility::public
		takes_reports  boolean = false
		// The preset its phases and steps started from, and the phase new issues
		// start in (workflow.one).
		workflow       workflow = workflow::basic
		start          phase
	}

	// A project's role: what it's called, and the commands it allows. Each project
	// starts with the two below and changes them, or adds its own, in its settings,
	// with no deploy.
	entity role {
		project  project  required  key
		name     slug     required  key
		title    text     required
		may      list of permission
	}

	// A person's place in a project, and what they may do there: one record for each
	// role they hold.
	entity member {
		project  project  required  key
		person   user     required  key
		role     role     required  key
	}

	// Maintainers run the project and its settings; members work on its issues.
	// Which steps between phases each role may take is the project's to say.
	roles role per project from member {
		maintainer "Maintainer" {
			project::update  member::create  member::delete  role::create  role::update
			phase::create  phase::update  phase::delete  step::create  step::update  step::delete
			issue::create  issue::update  issue::move  comment::create
			report::resolve  reply::create
		}
		member "Member"  issue::create  issue::update  issue::move  comment::create
	}

	command project::update
	command member::create

	// Taking a role away from someone, though never from yourself, so a project
	// always keeps the maintainer who took the others'.
	command member::delete {
		require person != me  "you can't remove yourself from a project"
	}

	command role::create
	command role::update

	// Every public project, newest first. A private project is listed nowhere.
	view all public {
		each project where visibility == visibility::public {
			order by created_at descending
			slug  name
		}
	}

	// The projects a person belongs to, public or private.
	view mine per user {
		each member where person == user.id {
			order by project
			project  project.name  role.title
		}
	}

	view project_page per project {
		readers member
		public when project.visibility == visibility::public
		name = project.name
		summary = project.summary
		visibility = project.visibility
		takes_reports = project.takes_reports
		start = project.start
		issues = each issue where project == project.id {
			order by number descending
			number  title  labels  phase  phase.title  priority  author.picture  author.name
		}
		phases = each phase where project == project.id {
			order by position
			name  title  position
		}
		steps = each step where project == project.id {
			order by from.position  to.position
			from  to  from.title  from.position  to.title  to.position  title  roles  roles.title
		}
		members = each member where project == project.id {
			order by role
			person  person.picture  person.name  role.title
		}
		roles = each role where project == project.id {
			order by name
			name  title  may
		}
		timeline = each change of issue where project == project.id {
			order by created_at descending
			limit 100
			issue  issue.number  issue.title  field  before  after  action  created_by.name  created_at
		}
	}

	screen "Projects" / {
		table all link /:project {
			slug "Project"
			name
		}
		table mine link /:project {
			project.name "Yours"
			role.title "Role"
		}
		table my_reports link /:project/reports/:report {
			project
			title "Your reports"
			status
		}
		project::create "New project"
		form project::create "Create project" {
			slug  name  summary  visibility  takes_reports  workflow "Start from"
		}
	}

	screen "{project_page.name}" /:project {
		markdown "{project_page.summary}"
		issue::create "New issue"
		form issue::create "Open issue" {
			title  body "Description"  priority  labels
		}
		project::update "Edit project"
		form project::update "Save" {
			name  summary  visibility  takes_reports
		}
		table project_page.issues link /:project/issues/:issue {
			search title labels phase.title priority
			sort by number descending
			page 25
			number "#"
			title
			labels
			phase.title "Phase"
			priority
			author.picture ""
			author.name "Opened by"
		}
		board project_page.issues by phase over project_page.phases link /:project/issues/:issue {
			move issue::move along project_page.steps
			title
			number "#"  priority  labels  author.picture
		}
		link /:project/timeline "Timeline"
		link /:project/people "People"
		link /:project/workflow "Workflow"
		link /:project/report "Report a problem privately"
		link /:project/reports "Reports, for its people"
	}

	// Everything that happened to a project's issues, newest first.
	screen "{project_page.name}: timeline" /:project/timeline {
		timeline project_page.timeline link /:project/issues/:issue
	}

	screen "People" /:project/people {
		table project_page.members {
			person.picture ""
			person.name "Name"
			role.title "Role"
			delete "Remove" when person != me
		}
		confirm member::delete "Take this role away from them?"
		member::create "Add someone"
		form member::create "Add" {
			person  role
		}
		link /:project/roles "Roles, and what each allows"
	}

	// A role's own page, where what it allows is changed.
	view role_page per role {
		readers member
		name = role.name
		title = role.title
		may = role.may
	}

	screen "Roles" /:project/roles {
		table project_page.roles link /:project/roles/:role {
			title "Role"
		}
		role::create "New role"
		form role::create "Create role" {
			name  title  may "Allows"
		}
	}

	screen "{role_page.title}" /:project/roles/:role {
		role::update "Edit"
		form role::update "Save" {
			title  may "Allows"
		}
	}

} // namespace projects
