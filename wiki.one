// A project's wiki: pages its people write together in Markdown, each keeping every
// change, as Trac's did.

namespace projects {

	entity page history {
		project  project   required  key
		name     text      required  key = slug(title)
		title    text      required
		body     markdown
		// Where it's listed among the wiki's pages, as they're arranged by dragging.
		position number
	}

	// A new page goes after the others.
	command page::create {
		if position == none {
			position = 1000
		}
	}

	command page::update

	view wiki_page per page {
		readers member
		public when page.project.visibility == visibility::public
		title = page.title
		body = page.body
		history = each change in page {
			order by created_at
			field  before  after  action  created_by.name  created_at
		}
	}

	screen "Wiki" /:project/wiki {
		text "Drag a page to move it. The project's page lists them in the same order."
		table project_page.pages link /:project/wiki/:page {
			reorder position
			search title
			title "Page"
			updated_at "Changed"
			page::create "New page"
		}
		form page::create "Add" {
			title  body
		}
	}

	screen "{wiki_page.title}" /:project/wiki/:page {
		heading {
			page::update "Edit" icon edit form "Save" {
				title  body
			}
		}
		markdown "{wiki_page.body}"
		timeline wiki_page.history
	}

} // namespace projects
