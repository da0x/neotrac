// Changes to what's stored that a deploy brings, each done once, the first time
// the backend starts with it. Each is removed once production has run it.

namespace projects {

	// A stage's end status is success, where it was done.
	once "2026-10-14 stage success" {
		each stage {
			if status != status::inactive && status != status::waiting && status != status::working && status != status::success && status != status::failed {
				dispatch stage::update { status = status::success }
			}
		}
	}

	// A board's styles are list, board, pipeline and whiteboard now: one shown as kanban,
	// or as a canvas before canvases had columns, is a board.
	once "2026-10-14 board styles" {
		each board {
			if style != style::list && style != style::board && style != style::pipeline && style != style::whiteboard {
				dispatch board::update { style = style::board }
			}
		}
	}

	// Boards can be private now, and the project's pages list only public ones; a
	// board made before then is public, as it always was. Stages say their cards'
	// dot: the presets' last stages are done, and the rest haven't started.
	once "2026-10-14 board visibility" {
		each board {
			if visibility == none {
				dispatch board::update { visibility = visibility::public }
			}
		}
		each stage {
			if status == none {
				if name == "done" || name == "completed" || name == "published" || name == "closed" || name == "accepted" {
					dispatch stage::update { status = status::success }
				} else {
					dispatch stage::update { status = status::inactive }
				}
			}
		}
	}

	// The role called member is now contributor, so it no longer shares its name with
	// the member entity. A role's name is its key, which never changes, so each
	// project gets a contributor role holding what its member role allowed, everything
	// that named the old one names the new, and the old one goes, by role::delete,
	// which maintainers may now do. What a later deploy adds to a role reaches every
	// project by itself; this first one says so here.
	// Issues are put in order on their boards now. Each issue made before then
	// starts where a new one would, at its number, so #1 comes first.
	once "2026-10-11 issue order" {
		each issue {
			if position == none {
				dispatch issue::update { position = number }
			}
		}
	}

	once "2026-10-09 contributor role" {
		each role where name == "member" {
			dispatch role::create {
				project = project  name = "contributor"
				title = "Contributor"  may = may
			}
		}
		each member {
			if role == role::member {
				dispatch member::create {
					project = project  person = person  role = role::contributor
				}
				dispatch member::delete
			}
		}
		each invitation {
			if role == role::member {
				dispatch invitation::create {
					project = project  email = email  role = role::contributor
				}
			}
		}
		each step {
			if roles has role::member {
				dispatch step::update {
					remove role::member from roles
					add role::contributor to roles
				}
			}
		}
		each role where name == "maintainer" {
			dispatch role::update { add role::delete to may }
		}
		each role where name == "member" {
			dispatch role::delete
		}
	}
}
