// Changes to what's stored that a deploy brings, each done once, the first time
// the backend starts with it. They stay here once done, as examples of the
// language.

namespace projects {

	// Every project made before boards takes one, called what the project is, with
	// the workflow and the issues it has: its phases, steps and issues are that
	// board's, and new issues start where they did. Maintainers may make and change
	// boards.
	once "2026-10-08 boards" {
		each project {
			create board { project = id  name = "main"  title = name  workflow = workflow  start = start  position = 1 }
		}
		each phase {
			board = board::main
		}
		each step {
			board = board::main
		}
		each issue {
			board = board::main
		}
		each role where name == "maintainer" {
			may = [
				project::update, member::create, member::delete, role::create, role::update,
				board::create, board::update,
				phase::create, phase::update, phase::delete, step::create, step::update, step::delete,
				issue::create, issue::update, issue::move, comment::create,
				report::resolve, reply::create,
			]
		}
	}

	// Every project made before milestones and its wiki lets its maintainers and
	// members make and change both, as new projects do.
	once "2026-10-08 milestones and the wiki" {
		each role where name == "maintainer" {
			add milestone::create to may
			add milestone::update to may
			add page::create to may
			add page::update to may
		}
		each role where name == "member" {
			add milestone::create to may
			add milestone::update to may
			add page::create to may
			add page::update to may
		}
	}

	// Triage is for bug reports. The workflow projects made before boards were given
	// starts in Backlog instead, the work waiting to be picked up; only its title
	// changes.
	once "2026-10-08 backlog" {
		each phase where name == "triage" {
			title = "Backlog"
		}
	}

	// Every project made before issues were linked, or moved between boards, lets its
	// maintainers and members do both, as new projects do.
	once "2026-10-08 links" {
		each role where name == "maintainer" {
			add issue::transfer to may
			add link::create to may
			add link::delete to may
		}
		each role where name == "member" {
			add issue::transfer to may
			add link::create to may
			add link::delete to may
		}
	}

	// Boards made from the presets before their phases were named in sentence case,
	// like the rest of neotrac, and without slashes, take the new names. A phase
	// renamed since keeps its own.
	once "2026-10-08 sentence case" {
		each phase where title == "To Do" {
			title = "To do"
		}
		each phase where title == "In Progress" {
			title = "In progress"
		}
		each phase where title == "Testing / Review" {
			title = "In review"
		}
		each phase where title == "Idea / Intake" {
			title = "Ideas"
		}
		each phase where title == "In Fixing" {
			title = "In fixing"
		}
	}

	// Wiki pages written before they could be arranged take their place in the order
	// they were written, each at 1000 as a new one is; the first drag numbers them.
	once "2026-10-08 wiki order" {
		each page {
			position = 1000
		}
	}

	// Priorities as Trac had them, five, Normal the one every issue starts with.
	// Medium was the middle of three and becomes Normal; an issue with none is Normal.
	once "2026-10-08 priorities" {
		each issue where priority == "medium" {
			priority = priority::normal
		}
		each issue where priority == none {
			priority = priority::normal
		}
	}

	// Maintainers of projects made before invitations invite people by email.
	once "2026-10-08 invitations" {
		each role where name == "maintainer" {
			add invitation::create to may
			add invitation::delete to may
		}
	}

} // namespace projects
