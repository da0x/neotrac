// A board's workflow: the phases its issues go through, its columns, and the steps
// between them, each naming the roles that may take it. A board starts from a
// preset and changes any of it on its Workflow page, with no deploy.

namespace projects {

	enum workflow {
		basic      "Basic task management"
		agile      "Agile / Scrum sprint"
		editorial  "Editorial & content planning"
		bugs       "Bug & issue tracker"
		adr        "Architecture decisions (ADRs)"
		custom     "Custom: Open and Done, to make your own"
	}

	// A phase of a board's issues, in its place among the others. Its name is made
	// from its title when it's added, and stays when it's renamed.
	entity phase {
		board     board    required  key
		name      text     required  key = slug(title)
		project   project  required
		title     text     required
		position  number
	}

	// From one phase to another, for the roles it names. A step back is a step of
	// its own.
	entity step {
		board    board    required  key
		from     phase    required  key
		to       phase    required  key
		project  project  required
		title    text
		roles    list of role
	}

	// A phase added goes after the others, until it's dragged elsewhere, unless it
	// says where, as a preset's phases do.
	command phase::create {
		if position == none {
			position = 1000
		}
	}

	command phase::update

	// A phase goes, and its issues move to another; the moves to and from it go
	// with it, and new issues start in the other if they started in it.
	command phase::delete {
		input into phase
		require into != id  "pick another phase for its issues"
		each issue where phase == id {
			dispatch issue::update { phase = into }
		}
		each step where from == id || to == id {
			dispatch step::delete
		}
		if board.start == id {
			dispatch board::update { id = board  start = into }
		}
	}

	command step::create
	command step::update
	command step::delete

	// A board starts from the preset it's made with: its phases, the steps between
	// them, and the phase its issues start in.
	command board::create {
		// One made on the project's page goes after the others.
		if position == none {
			position = 1000
		}
		// To do, in progress, done; anyone in the project moves an issue between any two.
		if workflow == workflow::basic {
			dispatch phase::create {
				board = id  project = project
				name = "to_do"  title = "To do"  position = 1
			}
			dispatch phase::create {
				board = id  project = project
				name = "in_progress"  title = "In progress"  position = 2
			}
			dispatch phase::create {
				board = id  project = project
				name = "done"  title = "Done"  position = 3
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::to_do  to = phase::in_progress
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::to_do  to = phase::done
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::in_progress  to = phase::to_do
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::in_progress  to = phase::done
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::done  to = phase::to_do
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::done  to = phase::in_progress
			}
			start = phase::to_do
		}
		// A sprint's backlog to completed, a step forward or back at a time.
		if workflow == workflow::agile {
			dispatch phase::create {
				board = id  project = project
				name = "backlog"  title = "Backlog"  position = 1
			}
			dispatch phase::create {
				board = id  project = project
				name = "to_do"  title = "To do"  position = 2
			}
			dispatch phase::create {
				board = id  project = project
				name = "in_progress"  title = "In progress"  position = 3
			}
			dispatch phase::create {
				board = id  project = project
				name = "review"  title = "In review"  position = 4
			}
			dispatch phase::create {
				board = id  project = project
				name = "completed"  title = "Completed"  position = 5
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::backlog  to = phase::to_do
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::to_do  to = phase::backlog
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::to_do  to = phase::in_progress
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::in_progress  to = phase::to_do
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::in_progress  to = phase::review
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::review  to = phase::in_progress
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::review  to = phase::completed
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::completed  to = phase::review
			}
			start = phase::backlog
		}
		// An idea to what's published, a step forward or back at a time.
		if workflow == workflow::editorial {
			dispatch phase::create {
				board = id  project = project
				name = "idea"  title = "Ideas"  position = 1
			}
			dispatch phase::create {
				board = id  project = project
				name = "writing"  title = "Writing"  position = 2
			}
			dispatch phase::create {
				board = id  project = project
				name = "editing"  title = "Editing"  position = 3
			}
			dispatch phase::create {
				board = id  project = project
				name = "scheduled"  title = "Scheduled"  position = 4
			}
			dispatch phase::create {
				board = id  project = project
				name = "published"  title = "Published"  position = 5
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::idea  to = phase::writing
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::writing  to = phase::idea
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::writing  to = phase::editing
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::editing  to = phase::writing
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::editing  to = phase::scheduled
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::scheduled  to = phase::editing
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::scheduled  to = phase::published
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::published  to = phase::scheduled
			}
			start = phase::idea
		}
		// Reported to closed, a step forward at a time; a fix that doesn't hold goes
		// back from verifying, and anything can be closed.
		if workflow == workflow::bugs {
			dispatch phase::create {
				board = id  project = project
				name = "reported"  title = "Reported"  position = 1
			}
			dispatch phase::create {
				board = id  project = project
				name = "triaged"  title = "Triaged"  position = 2
			}
			dispatch phase::create {
				board = id  project = project
				name = "in_fixing"  title = "In fixing"  position = 3
			}
			dispatch phase::create {
				board = id  project = project
				name = "verifying"  title = "Verifying"  position = 4
			}
			dispatch phase::create {
				board = id  project = project
				name = "closed"  title = "Closed"  position = 5
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::reported  to = phase::triaged
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::triaged  to = phase::in_fixing
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::in_fixing  to = phase::verifying
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::verifying  to = phase::in_fixing
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::verifying  to = phase::closed
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::reported  to = phase::closed
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::triaged  to = phase::closed
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::in_fixing  to = phase::closed
			}
			start = phase::reported
		}
		// A decision proposed, then accepted or rejected by the maintainers; later
		// deprecated, or superseded by another, whose link says it replaces this one.
		// A rejected one can be proposed again.
		if workflow == workflow::adr {
			dispatch phase::create {
				board = id  project = project
				name = "proposed"  title = "Proposed"  position = 1
			}
			dispatch phase::create {
				board = id  project = project
				name = "accepted"  title = "Accepted"  position = 2
			}
			dispatch phase::create {
				board = id  project = project
				name = "rejected"  title = "Rejected"  position = 3
			}
			dispatch phase::create {
				board = id  project = project
				name = "deprecated"  title = "Deprecated"  position = 4
			}
			dispatch phase::create {
				board = id  project = project
				name = "superseded"  title = "Superseded"  position = 5
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer]
				from = phase::proposed  to = phase::accepted
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer]
				from = phase::proposed  to = phase::rejected
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::rejected  to = phase::proposed
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer]
				from = phase::accepted  to = phase::deprecated
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer]
				from = phase::accepted  to = phase::superseded
			}
			start = phase::proposed
		}
		// Open and Done, each way, to rename, add to and rewire.
		if workflow == workflow::custom {
			dispatch phase::create {
				board = id  project = project
				name = "open"  title = "Open"  position = 1
			}
			dispatch phase::create {
				board = id  project = project
				name = "done"  title = "Done"  position = 2
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::open  to = phase::done
			}
			dispatch step::create {
				board = id  project = project  roles = [role::maintainer, role::contributor]
				from = phase::done  to = phase::open
			}
			start = phase::open
		}
	}

	screen "{board_page.title}: workflow" /:project/boards/:board/workflow {
		diagram board_page.steps by from and to over board_page.phases {
			roles.title
		}
		text "The phases an issue goes through, in order. Drag a phase to move it."
		table board_page.phases {
			reorder position
			title "Phase"
			update "Rename"
			delete "Remove"
			phase::create "New phase"
		}
		form phase::update "Save" {
			title "Called"
		}
		form phase::delete "Remove" {
			into "Move its issues to"
		}
		form phase::create "Add" {
			title "Called"
		}
		form board::update "Save" {
			start "New issues start in"
		}
		text "An issue moves only along the moves here: the arrows above, or in the grid"
			"from a phase on the left to one along the top. A move that isn't here,"
			"like In progress to Triage, isn't allowed."
		grid board_page.steps by from and to over board_page.phases {
			roles.title
		}
		form step::create "Allow" {
			roles "Taken by"  title "Says"
		}
		form step::update "Save" {
			roles "Taken by"  title "Says"
		}
		confirm step::delete "Remove this move? Issues can't go this way any more."
	}

} // namespace projects
