// A board's workflow: the stages its issues go through, its columns, and the steps
// between them, each naming the roles that may take it. A board starts from a
// preset and changes any of it on its Workflow page, with no deploy.

namespace projects {

	enum workflow {
		basic      "Basic task management"
		agile      "Software development"
		editorial  "Editorial & content planning"
		bugs       "Bug & issue tracker"
		adr        "Architecture decisions (ADRs)"
		custom     "Custom: Open and Done, to make your own"
	}

	// What a stage's issues are doing, as the dot on their cards says unless whoever
	// holds one says otherwise: success is an end, like Published, Live or Installed,
	// and what waits on an issue goes on once it reaches one.
	enum status {
		inactive  "Not started"
		waiting   "Waiting"
		working   "Working"
		success   "Success"
		failed    "Failed"
	}

	// A stage of a board's issues, in its place among the others. Its name is made
	// from its title when it's added, and stays when it's renamed.
	entity stage {
		board      board    required  key
		name       text     required  key = slug(title)
		project    project  = board.project
		title      text     required
		position   number
		// The roles whose people and services work its issues: a service holding
		// one sees them in its queue and takes them, one at a time.
		worked_by  list of role
		status     status  = status::inactive
		// How it tells the people watching its board that an issue arrived: chime is
		// heard so far, and email and text are to come.
		notify     list of text
		// The kinds of issue that go through it, by their labels, as a pipeline lays out
		// each kind's own path; none, every kind.
		kinds      list of text
		// How wide its column is on a board shown as a whiteboard.
		width      number
	}

	// From one stage to another, for the roles it names. A step back is a step of
	// its own.
	entity step {
		board    board    required  key
		from     stage    required  key
		to       stage    required  key
		project  project  = board.project
		title    text
		roles    list of role  = [role::maintainer, role::contributor]
	}

	// A stage added goes after the others, until it's dragged elsewhere, unless it
	// says where, as a preset's stages do.
	command stage::create {
		if position == none {
			position = 1000
		}
	}

	command stage::update

	// A stage goes, and its issues move to another; the moves to and from it go
	// with it, and new issues start in the other if they started in it.
	command stage::delete {
		input into stage
		require into != id  "pick another stage for its issues"
		each issue where stage == id {
			dispatch issue::update { stage = into }
		}
		each step where from == id || to == id {
			dispatch step::delete
		}
		if board.start == id {
			dispatch board::update { id = board  start = into }
		}
	}

	command step::create
	command step::update
	command step::delete

	// A board starts from the preset it's made with: its stages, the steps between
	// them, and the stage its issues start in.
	command board::create {
		// One made on the project's page goes after the others.
		if position == none {
			position = 1000
		}
		// To do, in progress, done; anyone in the project moves an issue between any two.
		if workflow == workflow::basic {
			dispatch stage::create {
				board = id  name = "to_do"  title = "To do"  position = 1
			}
			dispatch stage::create {
				board = id  name = "in_progress"  title = "In progress"  position = 2
			}
			dispatch stage::create {
				board = id  name = "done"  title = "Done"  position = 3  status = status::success
			}
			dispatch step::create { board = id  from = stage::to_do  to = stage::in_progress }
			dispatch step::create { board = id  from = stage::to_do  to = stage::done }
			dispatch step::create { board = id  from = stage::in_progress  to = stage::to_do }
			dispatch step::create { board = id  from = stage::in_progress  to = stage::done }
			dispatch step::create { board = id  from = stage::done  to = stage::to_do }
			dispatch step::create { board = id  from = stage::done  to = stage::in_progress }
			start = stage::to_do
		}
		// Software, from the backlog to completed, a step forward or back at a time.
		if workflow == workflow::agile {
			dispatch stage::create {
				board = id  name = "backlog"  title = "Backlog"  position = 1
			}
			dispatch stage::create {
				board = id  name = "to_do"  title = "To do"  position = 2
			}
			dispatch stage::create {
				board = id  name = "in_progress"  title = "In progress"  position = 3
			}
			dispatch stage::create {
				board = id  name = "review"  title = "In review"  position = 4
			}
			dispatch stage::create {
				board = id  name = "completed"  title = "Completed"  position = 5  status = status::success
			}
			dispatch step::create { board = id  from = stage::backlog  to = stage::to_do }
			dispatch step::create { board = id  from = stage::to_do  to = stage::backlog }
			dispatch step::create { board = id  from = stage::to_do  to = stage::in_progress }
			dispatch step::create { board = id  from = stage::in_progress  to = stage::to_do }
			dispatch step::create { board = id  from = stage::in_progress  to = stage::review }
			dispatch step::create { board = id  from = stage::review  to = stage::in_progress }
			dispatch step::create { board = id  from = stage::review  to = stage::completed }
			dispatch step::create { board = id  from = stage::completed  to = stage::review }
			start = stage::backlog
		}
		// An idea to what's published, a step forward or back at a time.
		if workflow == workflow::editorial {
			dispatch stage::create {
				board = id  name = "idea"  title = "Ideas"  position = 1
			}
			dispatch stage::create {
				board = id  name = "writing"  title = "Writing"  position = 2
			}
			dispatch stage::create {
				board = id  name = "editing"  title = "Editing"  position = 3
			}
			dispatch stage::create {
				board = id  name = "scheduled"  title = "Scheduled"  position = 4
			}
			dispatch stage::create {
				board = id  name = "published"  title = "Published"  position = 5  status = status::success
			}
			dispatch step::create { board = id  from = stage::idea  to = stage::writing }
			dispatch step::create { board = id  from = stage::writing  to = stage::idea }
			dispatch step::create { board = id  from = stage::writing  to = stage::editing }
			dispatch step::create { board = id  from = stage::editing  to = stage::writing }
			dispatch step::create { board = id  from = stage::editing  to = stage::scheduled }
			dispatch step::create { board = id  from = stage::scheduled  to = stage::editing }
			dispatch step::create { board = id  from = stage::scheduled  to = stage::published }
			dispatch step::create { board = id  from = stage::published  to = stage::scheduled }
			start = stage::idea
		}
		// Reported to closed, a step forward at a time; a fix that doesn't hold goes
		// back from verifying, and anything can be closed.
		if workflow == workflow::bugs {
			dispatch stage::create {
				board = id  name = "reported"  title = "Reported"  position = 1
			}
			dispatch stage::create {
				board = id  name = "triaged"  title = "Triaged"  position = 2
			}
			dispatch stage::create {
				board = id  name = "in_fixing"  title = "In fixing"  position = 3
			}
			dispatch stage::create {
				board = id  name = "verifying"  title = "Verifying"  position = 4
			}
			dispatch stage::create {
				board = id  name = "closed"  title = "Closed"  position = 5  status = status::success
			}
			dispatch step::create { board = id  from = stage::reported  to = stage::triaged }
			dispatch step::create { board = id  from = stage::triaged  to = stage::in_fixing }
			dispatch step::create { board = id  from = stage::in_fixing  to = stage::verifying }
			dispatch step::create { board = id  from = stage::verifying  to = stage::in_fixing }
			dispatch step::create { board = id  from = stage::verifying  to = stage::closed }
			dispatch step::create { board = id  from = stage::reported  to = stage::closed }
			dispatch step::create { board = id  from = stage::triaged  to = stage::closed }
			dispatch step::create { board = id  from = stage::in_fixing  to = stage::closed }
			start = stage::reported
		}
		// A decision proposed, then accepted or rejected by the maintainers; later
		// deprecated, or superseded by another, whose link says it replaces this one.
		// A rejected one can be proposed again.
		if workflow == workflow::adr {
			dispatch stage::create {
				board = id  name = "proposed"  title = "Proposed"  position = 1
			}
			dispatch stage::create {
				board = id  name = "accepted"  title = "Accepted"  position = 2  status = status::success
			}
			dispatch stage::create {
				board = id  name = "rejected"  title = "Rejected"  position = 3
			}
			dispatch stage::create {
				board = id  name = "deprecated"  title = "Deprecated"  position = 4
			}
			dispatch stage::create {
				board = id  name = "superseded"  title = "Superseded"  position = 5
			}
			dispatch step::create {
				board = id  roles = [role::maintainer]
				from = stage::proposed  to = stage::accepted
			}
			dispatch step::create {
				board = id  roles = [role::maintainer]
				from = stage::proposed  to = stage::rejected
			}
			dispatch step::create { board = id  from = stage::rejected  to = stage::proposed }
			dispatch step::create {
				board = id  roles = [role::maintainer]
				from = stage::accepted  to = stage::deprecated
			}
			dispatch step::create {
				board = id  roles = [role::maintainer]
				from = stage::accepted  to = stage::superseded
			}
			start = stage::proposed
		}
		// Open and Done, each way, to rename, add to and rewire.
		if workflow == workflow::custom {
			dispatch stage::create {
				board = id  name = "open"  title = "Open"  position = 1
			}
			dispatch stage::create {
				board = id  name = "done"  title = "Done"  position = 2  status = status::success
			}
			dispatch step::create { board = id  from = stage::open  to = stage::done }
			dispatch step::create { board = id  from = stage::done  to = stage::open }
			start = stage::open
		}
	}

	screen "{board_page.title}: workflow" /:project/boards/:board/workflow {
		diagram board_page.steps by from and to over board_page.stages {
			roles.title
		}
		text "The stages an issue goes through, in order. Drag a stage to move it."
		table board_page.stages {
			reorder position
			title "Stage"
			worked_by.title "Worked by"
			status "Dot"
			notify "Tells"
			kinds "For"
			update "Change"
			delete "Remove"
			stage::create "New stage"
		}
		form stage::update "Save" {
			title "Called"  worked_by "Worked by"  status "Its cards' dot"
			notify "When an issue arrives" {
				hint "chime rings for everyone watching the board; email and text are to come."
			}
			kinds "For issues labelled" {
				hint "On a board shown as a pipeline, the kinds of issue that go through this stage, by their labels; none, every kind."
			}
		}
		form stage::delete "Remove" {
			into "Move its issues to"
		}
		form stage::create "Add" {
			title "Called"  worked_by "Worked by"  status "Its cards' dot"
			notify "When an issue arrives" {
				hint "chime rings for everyone watching the board; email and text are to come."
			}
			kinds "For issues labelled" {
				hint "On a board shown as a pipeline, the kinds of issue that go through this stage, by their labels; none, every kind."
			}
		}
		form board::update "Save" {
			start "New issues start in"
		}
		text "An issue moves only along the moves here: the arrows above, or in the grid"
			"from a stage on the left to one along the top. A move that isn't here,"
			"like In progress to Triage, isn't allowed."
		grid board_page.steps by from and to over board_page.stages {
			roles.title
		}
		form step::create "Allow" {
			roles "Taken by"  title "Says"
		}
		form step::update "Save" {
			roles "Taken by"  title "Says"
		}
		confirm step::delete "Remove this move? Issues can't go this way any more."
	}

} // namespace projects
