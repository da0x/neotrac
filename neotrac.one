// neotrac: open project tracking for everyone. Projects, their people, and the
// issues they work on, with every change kept.

import one

project neotrac {
	one             "0.15.2"
	target          web desktop terminal
	region          "us-east4"
	ui              radix
	signin          google github
	icon            "assets/icon.svg"
	theme           split_complementary_86124
	appearance      light
	accessibility   menu
	analytics       google
	
	environment production {
		domain    "neotrac.org" "www.neotrac.org"
		firebase  "neotrac"
	}
}

// PaperColor's colors, with square corners for a sharper look.
define theme neotrac "neotrac" from harbor {
	corners  2
	depth    flat
}

header {
	badge news.unread
	navigation projects docs download about license
}

footer {
	text "© {year} [Daher Alfawares](https://www.linkedin.com/in/daheralfawares)"
	link namespace license "AGPL-3.0-only"
	link build.release "uione {build.version}"
	link build.source "{build.commit}"
}
