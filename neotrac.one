// neotrac: open project tracking for everyone. Projects, their people, and the
// issues they work on, with every change kept.

import one

project neotrac {
	one             "0.7.2"
	region          "us-east4"
	ui              radix
	signin          google
	signin          github
	icon            "assets/icon.svg"
	theme           papercolor
	appearance      light
	corners         square
	analytics       google
	
	environment production {
		domain    "neotrac.org"
		firebase  "neotrac"
	}
}

header {
	badge news.unread
}

footer {
	text "© {year} [Daher Alfawares](https://www.linkedin.com/in/daheralfawares)"
	link build.release "uione {build.version}"
	link build.source "{build.commit}"
}
