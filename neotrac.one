// neotrac: open project tracking for everyone. Projects, their people, and the
// issues they work on, with every change kept.

project neotrac {
	one             "0.6.20"
	region          "us-east4"
	ui              radix
	signin          google
	signin          github
	icon            "assets/icon.svg"
	theme           papercolor
	corners         square
	analytics       google
	
	environment production {
		domain    "neotrac.org"
		firebase  "neotrac"
	}
}
